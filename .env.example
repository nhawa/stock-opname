# Development database (matches docker-compose.yml)
DATABASE_URL=postgres://stock_opname:stock_opname@127.0.0.1:5432/stock_opname

# A separate disposable database is required for integration tests.
DATABASE_URL_TEST=postgres://stock_opname_test:replace-with-test-password@127.0.0.1:5433/stock_opname_test

# Required API configuration. Use a unique 32+ character secret outside this example.
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_ISSUER=stock-opname-api
JWT_AUDIENCE=stock-opname-client
JWT_EXPIRES_IN_SECONDS=900
COUNT_RESERVATION_ACTIVE_SECONDS=600
PORT=3000
